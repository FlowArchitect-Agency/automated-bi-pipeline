# ═══════════════════════════════════════════════════════════════
# Automated BI Pipeline with AI Enrichment — environment template
# Copy to `.env` and fill in. `.env` is gitignored — never commit it.
# ═══════════════════════════════════════════════════════════════

# ── Warehouse database (read/write for the pipeline) ───────────
WAREHOUSE_DB=warehouse
WAREHOUSE_USER=bi_user
WAREHOUSE_PASSWORD=bi_dev_password
WAREHOUSE_HOST=warehouse
WAREHOUSE_PORT=5432

# Read-only credentials used by the Streamlit dashboard.
WAREHOUSE_READER_PASSWORD=reader_dev_password

# ── Airflow metadata database ──────────────────────────────────
AIRFLOW_DB=airflow
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=airflow_dev_password
AIRFLOW_DB_HOST=airflow-db
AIRFLOW_DB_PORT=5432

# Airflow UI credentials (local dev only)
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow
AIRFLOW_UID=50000

# ── AI enrichment mode ─────────────────────────────────────────
# mock  = deterministic, offline, zero-cost, always available (default)
# llm   = real LLM calls via an OpenAI-compatible endpoint
ENRICHMENT_MODE=mock

# ── LLM provider (only used when ENRICHMENT_MODE=llm) ──────────
# Options: nvidia | anthropic | ollama | openai-compatible
#   nvidia  → NVIDIA NIM (build.nvidia.com) FREE tier, OpenAI-compatible
#   anthropic→ Anthropic Claude (paid) via the Messages API
#   ollama  → local Ollama (free, offline) via its OpenAI shim
LLM_PROVIDER=nvidia

# ── Provider endpoints & keys ──────────────────────────────────
# NVIDIA NIM (free tier — https://build.nvidia.com)
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=deepseek-ai/deepseek-r1

# Anthropic Claude (paid — https://console.anthropic.com)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Ollama (local — http://localhost:11434)
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
OLLAMA_MODEL=llama3.1

# LLM tuning (safety rails shared across providers)
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
LLM_TEMPERATURE=0.0

# ── Notifications ──────────────────────────────────────────────
# Leave blank to disable Slack — the pipeline logs a structured
# "notification_skipped" record instead of failing.
SLACK_WEBHOOK_URL=

# ── Pipeline behaviour ─────────────────────────────────────────
# Anomaly sensitivity (standard deviations / IQR multiplier)
ANOMALY_THRESHOLD=3.0
# Run timezone for report timestamps
RUN_TIMEZONE=Europe/Paris
# UI / report language: en | fr (data is bilingual either way)
DEFAULT_LANG=en
